MERGECHAT_DATABASE_URL=sqlite:///./mergechat.db
# Generate with: openssl rand -base64 32
MERGECHAT_SESSION_ENCRYPTION_KEY=
MERGECHAT_LOG_LEVEL=INFO
MERGECHAT_RETENTION_DAYS=30
MERGECHAT_API_HOST=127.0.0.1
MERGECHAT_API_PORT=8000
# Optional. Required for non-loopback access; send as Authorization: Bearer <token>.
MERGECHAT_API_TOKEN=

MERGECHAT_JEV_BASE_URL=https://polza.ai/api
MERGECHAT_JEV_API_KEY=
MERGECHAT_JEV_MODEL=
MERGECHAT_JEV_TIMEOUT_SECONDS=30
MERGECHAT_JEV_CONFIDENCE_THRESHOLD=0.5

MERGECHAT_MAX_PHONE=
MERGECHAT_MAX_SESSION_NAME=mergechat.db
MERGECHAT_MAX_WORK_DIR=sessions
MERGECHAT_MAX_CONNECT_TIMEOUT_SECONDS=20
